{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intro2society-service-hub",
  "main": "workers/service-hub/worker.js",
  "compatibility_date": "2026-11-25",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "services": [
    {
      "binding": "AGENT_STARTER",
      "service": "agent-starter"
    },
    {
      "binding": "PROBATE_PORTAL",
      "service": "probate-portal"
    },
    {
      "binding": "COMMUNITY_BLACKBOARD",
      "service": "community-blackboard"
    }
  ]
}
