{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intro2society-service-hub",
  "main": "workers/service-hub/worker.js",
  "compatibility_date": "2026-11-25",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    },
    "redact_query_string": true
  },
  "services": [
    {
      "binding": "AGENT_STARTER",
      "service": "agent-starter"
    },
    {
      "binding": "PROBATE_PORTAL",
      "service": "probate-portal"
    },
    {
      "binding": "COMMUNITY_BLACKBOARD",
      "service": "community-blackboard"
    }
  ],
  "routes": [
    {
      "pattern": "theintro2society.org/__hub/*",
      "zone_name": "theintro2society.org"
    },
    {
      "pattern": "theintro2society.org/blackboard*",
      "zone_name": "theintro2society.org"
    },
    {
      "pattern": "theintro2society.org/probate*",
      "zone_name": "theintro2society.org"
    },
    {
      "pattern": "theintro2society.org/api/probate-search*",
      "zone_name": "theintro2society.org"
    }
  ],
  "account_id": "6d121e7041ead643e98f3562a9866c0a"
}
